<?xml version="1.0" encoding="utf-8"?>
<!-- Pretendard 폰트 패밀리 — 디자인 시안 폰트. 웹(next/font)과 동일하게 self-host한다. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font android:fontStyle="normal" android:fontWeight="400" android:font="@font/pretendard_regular" />
    <font android:fontStyle="normal" android:fontWeight="500" android:font="@font/pretendard_medium" />
    <font android:fontStyle="normal" android:fontWeight="600" android:font="@font/pretendard_semibold" />
    <font android:fontStyle="normal" android:fontWeight="700" android:font="@font/pretendard_bold" />
</font-family>
